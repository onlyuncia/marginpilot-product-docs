{
  "openapi": "3.1.0",
  "info": {
    "title": "MarginPilot — внутренний API",
    "version": "1.0.0-case",
    "description": "Реконструкция API для портфолио по согласованным сценариям работающей системы. Пути, JSON-поля и HTTP-коды не являются выгрузкой исходной спецификации. Доступ требует авторизации, но способ передачи сессии не реконструирован. Примеры обезличены."
  },
  "servers": [
    { "url": "/api/v1", "description": "Относительный базовый путь внутреннего API" }
  ],
  "tags": [
    { "name": "Товары и оценка" },
    { "name": "Пакеты изменений" },
    { "name": "План-факт" }
  ],
  "paths": {
    "/cabinets/{cabinet_id}/skus": {
      "parameters": [
        { "$ref": "#/components/parameters/CabinetId" }
      ],
      "get": {
        "tags": ["Товары и оценка"],
        "operationId": "listSkus",
        "summary": "Получить страницу товаров кабинета",
        "description": "Название и миниатюра помогают менеджеру найти SKU. Отсутствующие справочные данные не заменяются вымышленными значениями.",
        "parameters": [
          { "$ref": "#/components/parameters/Search" },
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/Cursor" }
        ],
        "responses": {
          "200": {
            "description": "Страница SKU",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SkuPage" },
                "example": {
                  "items": [
                    {
                      "seller_sku": "SKU-DEMO-001",
                      "name": "Товар для примера",
                      "thumbnail_url": "https://example.com/demo/sku-001.jpg"
                    }
                  ],
                  "next_cursor": null
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/cabinets/{cabinet_id}/evaluations": {
      "parameters": [
        { "$ref": "#/components/parameters/CabinetId" }
      ],
      "post": {
        "tags": ["Товары и оценка"],
        "operationId": "evaluateEconomics",
        "summary": "Оценить экономику выбранных SKU",
        "description": "Цена ниже порога возвращается в результате оценки, а не как HTTP-ошибка. При создании пакета сервер выполняет бизнес-проверку заново.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/EvaluationRequest" },
              "example": {
                "action": "change_price",
                "items": [
                  { "seller_sku": "SKU-DEMO-001", "proposed_price": "1290.00" },
                  { "seller_sku": "SKU-DEMO-002", "proposed_price": "890.00" }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Результат расчёта по каждому SKU",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EvaluationResponse" },
                "example": {
                  "items": [
                    {
                      "seller_sku": "SKU-DEMO-001",
                      "economic_threshold": "1100.00",
                      "planned_profit_per_unit": "90.00",
                      "price_check": "allowed"
                    },
                    {
                      "seller_sku": "SKU-DEMO-002",
                      "economic_threshold": "1000.00",
                      "planned_profit_per_unit": "-40.00",
                      "price_check": "below_threshold"
                    }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "422": { "$ref": "#/components/responses/Unprocessable" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/ExternalUnavailable" },
          "504": { "$ref": "#/components/responses/ExternalTimeout" }
        }
      }
    },
    "/cabinets/{cabinet_id}/price-batches": {
      "parameters": [
        { "$ref": "#/components/parameters/CabinetId" }
      ],
      "post": {
        "tags": ["Пакеты изменений"],
        "operationId": "createPriceBatch",
        "summary": "Принять пакет новых цен к обработке",
        "description": "Подтверждение цены ниже порога передаётся по каждому SKU. Отмена в интерфейсе не вызывает эту операцию. Повтор того же тела с тем же ключом возвращает исходный batch_id без повторной отправки в Ozon.",
        "parameters": [
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PriceBatchRequest" },
              "example": {
                "items": [
                  { "seller_sku": "SKU-DEMO-001", "proposed_price": "1290.00" },
                  {
                    "seller_sku": "SKU-DEMO-002",
                    "proposed_price": "890.00",
                    "include_below_threshold": true
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "202": { "$ref": "#/components/responses/BatchAccepted" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/Unprocessable" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/ExternalUnavailable" },
          "504": { "$ref": "#/components/responses/ExternalTimeout" }
        }
      }
    },
    "/cabinets/{cabinet_id}/promotion-batches": {
      "parameters": [
        { "$ref": "#/components/parameters/CabinetId" }
      ],
      "post": {
        "tags": ["Пакеты изменений"],
        "operationId": "createPromotionBatch",
        "summary": "Принять изменение участия в акции к обработке",
        "description": "При добавлении нужна отдельная цена входа. При удалении цена не передаётся: прежнюю цену восстанавливает Ozon. Пока исход того же действия по SKU и акции неизвестен, повторный запрос не создаётся.",
        "parameters": [
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PromotionBatchRequest" },
              "example": {
                "action": "add_to_promotion",
                "items": [
                  {
                    "seller_sku": "SKU-DEMO-002",
                    "promotion_id": "PROMO-DEMO-01",
                    "promo_entry_price": "890.00",
                    "include_below_threshold": true
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "202": { "$ref": "#/components/responses/BatchAccepted" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/Unprocessable" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/ExternalUnavailable" },
          "504": { "$ref": "#/components/responses/ExternalTimeout" }
        }
      }
    },
    "/batches/{batch_id}": {
      "parameters": [
        { "$ref": "#/components/parameters/BatchId" }
      ],
      "get": {
        "tags": ["Пакеты изменений"],
        "operationId": "getBatch",
        "summary": "Получить текущее состояние пакета и SKU",
        "description": "Пока страница результата открыта и пакет обрабатывается, интерфейс повторяет этот запрос автоматически. HTTP 200 означает успешное чтение состояния, а не успешное применение всех изменений в Ozon.",
        "responses": {
          "200": {
            "description": "Состояние отправки и сверки по SKU",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BatchResult" },
                "example": {
                  "batch_id": "00000000-0000-4000-8000-000000000101",
                  "cabinet_id": "00000000-0000-4000-8000-000000000001",
                  "action": "change_price",
                  "status": "partial",
                  "items": [
                    {
                      "seller_sku": "SKU-DEMO-001",
                      "submission_result": "reported_success",
                      "verification_result": "matched",
                      "target_price": "1290.00",
                      "actual_price": "1290.00",
                      "error": null
                    },
                    {
                      "seller_sku": "SKU-DEMO-002",
                      "submission_result": "rejected",
                      "verification_result": "mismatch",
                      "target_price": "890.00",
                      "actual_price": "1090.00",
                      "error": {
                        "code": "OZON_REJECTED",
                        "message": "Ozon отклонил изменение"
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/cabinets/{cabinet_id}/skus/{seller_sku}/plan-fact": {
      "parameters": [
        { "$ref": "#/components/parameters/CabinetId" },
        { "$ref": "#/components/parameters/SellerSku" }
      ],
      "get": {
        "tags": ["План-факт"],
        "operationId": "getPlanFact",
        "summary": "Сравнить плановую и фактическую экономику SKU",
        "description": "Версия плана выбирается по времени каждой продажи. Продажи и фактические расходы уже хранятся в PostgreSQL; открытие экрана не означает новый запрос к 1С или Ozon.",
        "parameters": [
          { "$ref": "#/components/parameters/PeriodStart" },
          { "$ref": "#/components/parameters/PeriodEnd" }
        ],
        "responses": {
          "200": {
            "description": "План, факт и отклонение за период",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PlanFact" },
                "example": {
                  "cabinet_id": "00000000-0000-4000-8000-000000000001",
                  "seller_sku": "SKU-DEMO-001",
                  "period_start": "2025-10-01",
                  "period_end": "2025-10-31",
                  "sold_units": 2,
                  "planned_profit_total": "600.00",
                  "actual_profit_total": "520.00",
                  "profit_deviation_total": "-80.00",
                  "profit_deviation_per_unit": "-40.00",
                  "actual_expenses": [
                    { "expense_type": "advertising", "amount": "120.00" }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "422": { "$ref": "#/components/responses/Unprocessable" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "CabinetId": {
        "name": "cabinet_id",
        "in": "path",
        "required": true,
        "description": "Внутренний UUID кабинета, не ozon_client_id.",
        "schema": { "type": "string", "format": "uuid" },
        "example": "00000000-0000-4000-8000-000000000001"
      },
      "BatchId": {
        "name": "batch_id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" },
        "example": "00000000-0000-4000-8000-000000000101"
      },
      "SellerSku": {
        "name": "seller_sku",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "minLength": 1 },
        "example": "SKU-DEMO-001"
      },
      "Search": {
        "name": "search",
        "in": "query",
        "description": "Поиск товара на экране оценки.",
        "schema": { "type": "string" }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "schema": { "type": "string" }
      },
      "PeriodStart": {
        "name": "period_start",
        "in": "query",
        "required": true,
        "schema": { "type": "string", "format": "date" },
        "example": "2025-10-01"
      },
      "PeriodEnd": {
        "name": "period_end",
        "in": "query",
        "required": true,
        "description": "Конец периода включительно. Должен быть не раньше period_start.",
        "schema": { "type": "string", "format": "date" },
        "example": "2025-10-31"
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "Один ключ и то же тело возвращают исходный batch_id; тот же ключ с другим телом даёт 409.",
        "schema": { "type": "string", "minLength": 1 },
        "example": "demo-price-001"
      }
    },
    "responses": {
      "BatchAccepted": {
        "description": "Пакет сохранён и принят в обработку. Результат Ozon ещё не подтверждён.",
        "headers": {
          "Location": {
            "description": "Адрес получения состояния пакета.",
            "schema": { "type": "string" },
            "example": "/api/v1/batches/00000000-0000-4000-8000-000000000101"
          }
        },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/BatchAcceptedBody" },
            "example": {
              "batch_id": "00000000-0000-4000-8000-000000000101",
              "status": "accepted",
              "accepted_items": 2
            }
          }
        }
      },
      "BadRequest": {
        "description": "Нечитаемый JSON или неверный формат параметра.",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } }
      },
      "Unauthorized": {
        "description": "Требуется авторизованная сессия.",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } }
      },
      "NotFound": {
        "description": "Кабинет, SKU или пакет не найден либо недоступен менеджеру.",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } }
      },
      "Conflict": {
        "description": "То же действие ещё выполняется либо ключ идемпотентности использован с другим телом.",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } }
      },
      "Unprocessable": {
        "description": "Бизнес-валидация не пройдена: например, пустой пакет, цена ниже порога без подтверждения или некорректный период.",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/ProblemDetails" }
          }
        }
      },
      "InternalError": {
        "description": "Внутренняя ошибка MarginPilot до принятия команды.",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } }
      },
      "ExternalUnavailable": {
        "description": "Нужный внешний источник недоступен до принятия команды.",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } }
      },
      "ExternalTimeout": {
        "description": "Чтение внешнего источника до принятия команды завершилось таймаутом.",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } }
      }
    },
    "schemas": {
      "Money": {
        "type": "string",
        "pattern": "^-?[0-9]+\\.[0-9]{2}$",
        "description": "Десятичная сумма в рублях строкой, допускает отрицательный результат.",
        "examples": ["-40.00"]
      },
      "Price": {
        "type": "string",
        "pattern": "^[0-9]+\\.[0-9]{2}$",
        "description": "Цена в рублях строкой. Положительность проверяется бизнес-валидацией.",
        "examples": ["1290.00"]
      },
      "NullableMoney": {
        "type": ["string", "null"],
        "pattern": "^-?[0-9]+\\.[0-9]{2}$",
        "description": "null означает, что показатель нельзя достоверно рассчитать."
      },
      "SkuSummary": {
        "type": "object",
        "required": ["seller_sku"],
        "properties": {
          "seller_sku": { "type": "string" },
          "name": { "type": ["string", "null"] },
          "thumbnail_url": { "type": ["string", "null"], "format": "uri" }
        }
      },
      "SkuPage": {
        "type": "object",
        "required": ["items", "next_cursor"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/SkuSummary" } },
          "next_cursor": { "type": ["string", "null"] }
        }
      },
      "EvaluationRequest": {
        "oneOf": [
          { "$ref": "#/components/schemas/PriceEvaluationRequest" },
          { "$ref": "#/components/schemas/PromotionAddEvaluationRequest" },
          { "$ref": "#/components/schemas/PromotionRemoveEvaluationRequest" }
        ]
      },
      "PriceEvaluationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "items"],
        "properties": {
          "action": { "type": "string", "enum": ["change_price"] },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/components/schemas/PriceCandidate" }
          }
        }
      },
      "PriceCandidate": {
        "type": "object",
        "additionalProperties": false,
        "required": ["seller_sku", "proposed_price"],
        "properties": {
          "seller_sku": { "type": "string", "minLength": 1 },
          "proposed_price": { "$ref": "#/components/schemas/Price" }
        }
      },
      "PromotionAddEvaluationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "items"],
        "properties": {
          "action": { "type": "string", "enum": ["add_to_promotion"] },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/components/schemas/PromotionAddCandidate" }
          }
        }
      },
      "PromotionAddCandidate": {
        "type": "object",
        "additionalProperties": false,
        "required": ["seller_sku", "promotion_id", "promo_entry_price"],
        "properties": {
          "seller_sku": { "type": "string", "minLength": 1 },
          "promotion_id": { "type": "string", "minLength": 1 },
          "promo_entry_price": { "$ref": "#/components/schemas/Price" }
        }
      },
      "PromotionRemoveEvaluationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "items"],
        "properties": {
          "action": { "type": "string", "enum": ["remove_from_promotion"] },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/components/schemas/PromotionRemoveItem" }
          }
        }
      },
      "EvaluationResponse": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/EvaluationItem" }
          }
        }
      },
      "EvaluationItem": {
        "type": "object",
        "required": ["seller_sku", "economic_threshold", "planned_profit_per_unit", "price_check"],
        "properties": {
          "seller_sku": { "type": "string" },
          "economic_threshold": { "$ref": "#/components/schemas/NullableMoney" },
          "planned_profit_per_unit": { "$ref": "#/components/schemas/NullableMoney" },
          "price_check": {
            "type": "string",
            "enum": ["allowed", "below_threshold", "not_applicable"]
          }
        }
      },
      "PriceBatchRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/components/schemas/PriceBatchItem" }
          }
        }
      },
      "PriceBatchItem": {
        "type": "object",
        "additionalProperties": false,
        "required": ["seller_sku", "proposed_price"],
        "properties": {
          "seller_sku": { "type": "string", "minLength": 1 },
          "proposed_price": { "$ref": "#/components/schemas/Price" },
          "include_below_threshold": {
            "type": "boolean",
            "default": false,
            "description": "Явное подтверждение отправки этого SKU ниже экономического порога."
          }
        }
      },
      "PromotionBatchRequest": {
        "oneOf": [
          { "$ref": "#/components/schemas/PromotionAddBatchRequest" },
          { "$ref": "#/components/schemas/PromotionRemoveBatchRequest" }
        ]
      },
      "PromotionAddBatchRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "items"],
        "properties": {
          "action": { "type": "string", "enum": ["add_to_promotion"] },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/components/schemas/PromotionAddBatchItem" }
          }
        }
      },
      "PromotionAddBatchItem": {
        "type": "object",
        "additionalProperties": false,
        "required": ["seller_sku", "promotion_id", "promo_entry_price"],
        "properties": {
          "seller_sku": { "type": "string", "minLength": 1 },
          "promotion_id": { "type": "string", "minLength": 1 },
          "promo_entry_price": { "$ref": "#/components/schemas/Price" },
          "include_below_threshold": {
            "type": "boolean",
            "default": false,
            "description": "Явное подтверждение цены входа ниже порога."
          }
        }
      },
      "PromotionRemoveBatchRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "items"],
        "properties": {
          "action": { "type": "string", "enum": ["remove_from_promotion"] },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/components/schemas/PromotionRemoveItem" }
          }
        }
      },
      "PromotionRemoveItem": {
        "type": "object",
        "additionalProperties": false,
        "required": ["seller_sku", "promotion_id"],
        "properties": {
          "seller_sku": { "type": "string", "minLength": 1 },
          "promotion_id": { "type": "string", "minLength": 1 }
        }
      },
      "BatchAcceptedBody": {
        "type": "object",
        "required": ["batch_id", "status", "accepted_items"],
        "properties": {
          "batch_id": { "type": "string", "format": "uuid" },
          "status": { "type": "string", "enum": ["accepted"] },
          "accepted_items": { "type": "integer", "minimum": 1 }
        }
      },
      "BatchResult": {
        "type": "object",
        "required": ["batch_id", "cabinet_id", "action", "status", "items"],
        "properties": {
          "batch_id": { "type": "string", "format": "uuid" },
          "cabinet_id": { "type": "string", "format": "uuid" },
          "action": {
            "type": "string",
            "enum": ["change_price", "add_to_promotion", "remove_from_promotion"]
          },
          "status": {
            "type": "string",
            "enum": ["accepted", "verifying", "confirmed", "partial", "unconfirmed"]
          },
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/BatchItemResult" }
          }
        }
      },
      "BatchItemResult": {
        "type": "object",
        "required": ["seller_sku", "submission_result", "verification_result"],
        "properties": {
          "seller_sku": { "type": "string" },
          "submission_result": {
            "type": "string",
            "enum": ["pending", "reported_success", "rejected", "unknown"],
            "description": "Ответ на отправку. pending — ответ ещё ожидается; unknown — время ожидания истекло."
          },
          "verification_result": {
            "type": "string",
            "enum": ["pending", "matched", "mismatch"],
            "description": "Результат отдельного чтения фактического состояния в Ozon."
          },
          "target_price": { "$ref": "#/components/schemas/NullableMoney" },
          "actual_price": { "$ref": "#/components/schemas/NullableMoney" },
          "promotion_id": { "type": "string" },
          "actual_participation": { "type": ["boolean", "null"] },
          "error": {
            "oneOf": [
              { "$ref": "#/components/schemas/ItemError" },
              { "type": "null" }
            ]
          }
        }
      },
      "ItemError": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" }
        }
      },
      "PlanFact": {
        "type": "object",
        "required": [
          "cabinet_id", "seller_sku", "period_start", "period_end", "sold_units",
          "planned_profit_total", "actual_profit_total", "profit_deviation_total",
          "profit_deviation_per_unit", "actual_expenses"
        ],
        "properties": {
          "cabinet_id": { "type": "string", "format": "uuid" },
          "seller_sku": { "type": "string" },
          "period_start": { "type": "string", "format": "date" },
          "period_end": { "type": "string", "format": "date" },
          "sold_units": { "type": "integer", "minimum": 0 },
          "planned_profit_total": { "$ref": "#/components/schemas/NullableMoney" },
          "actual_profit_total": { "$ref": "#/components/schemas/NullableMoney" },
          "profit_deviation_total": { "$ref": "#/components/schemas/NullableMoney" },
          "profit_deviation_per_unit": {
            "type": ["string", "null"],
            "pattern": "^-?[0-9]+\\.[0-9]{2}$",
            "description": "null при нулевых продажах или отсутствии действовавшей версии плана."
          },
          "actual_expenses": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ActualExpense" }
          }
        }
      },
      "ActualExpense": {
        "type": "object",
        "required": ["expense_type", "amount"],
        "properties": {
          "expense_type": { "type": "string" },
          "amount": { "$ref": "#/components/schemas/Money" }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "required": ["type", "title", "status", "detail", "code"],
        "properties": {
          "type": { "type": "string", "format": "uri" },
          "title": { "type": "string" },
          "status": { "type": "integer", "minimum": 400, "maximum": 599 },
          "detail": { "type": "string" },
          "code": { "type": "string" },
          "seller_skus": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
