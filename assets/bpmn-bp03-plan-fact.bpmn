<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_BP03_PlanFact"
                  targetNamespace="https://marginpilot.example/portfolio/bpmn">
  <bpmn:dataStore id="DataStore_Economy" name="PostgreSQL: продажи, расходы и версии плана"/>
  <bpmn:process id="BP03_PlanFact" name="БП-03. Анализ плановой и фактической экономики SKU" isExecutable="false">
    <bpmn:documentation>Схема показывает анализ уже сохранённых данных. Обмен с 1С и Ozon относится к вспомогательному процессу ВП-01 и не запускается самим открытием результата.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_BP03">
      <bpmn:lane id="Lane_Manager" name="Менеджер">
        <bpmn:flowNodeRef>Start_AnalysisNeeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectSkuPeriod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_AnalysisReviewed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_MarginPilot" name="MarginPilot">
        <bpmn:flowNodeRef>Task_LoadStoredData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HasSales</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MatchPlanVersions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CalculatePlanFact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NoSalesResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ShowResult</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_AnalysisNeeded" name="Нужно изучить результат продаж">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_SelectSkuPeriod" name="Выбрать SKU и период">
      <bpmn:incoming>Flow_01</bpmn:incoming><bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_LoadStoredData" name="Прочитать сохранённые продажи, расходы и версии плана">
      <bpmn:documentation>Данные поступили ранее через ВП-01 и хранятся в PostgreSQL. Открытие экрана не означает прямой запрос к 1С или Ozon.</bpmn:documentation>
      <bpmn:incoming>Flow_02</bpmn:incoming><bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_HasSales" name="Есть продажи за период?">
      <bpmn:incoming>Flow_03</bpmn:incoming><bpmn:outgoing>Flow_04</bpmn:outgoing><bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_MatchPlanVersions" name="Найти действовавшую версию плана для каждой продажи">
      <bpmn:documentation>Используется версия, действовавшая в момент продажи, а не последняя версия на момент просмотра.</bpmn:documentation>
      <bpmn:incoming>Flow_04</bpmn:incoming><bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CalculatePlanFact" name="Рассчитать план, факт и отклонение за период">
      <bpmn:documentation>План суммируется по фактически проданным единицам. Фактические рекламные расходы учитываются отдельно от планового расхода на продажу. Отклонение равно факту минус плану.</bpmn:documentation>
      <bpmn:incoming>Flow_06</bpmn:incoming><bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_NoSalesResult" name="Учесть фактические расходы без расчёта на единицу">
      <bpmn:documentation>При нулевых продажах фактические расходы остаются видны, но показатели на проданную единицу не рассчитываются.</bpmn:documentation>
      <bpmn:incoming>Flow_05</bpmn:incoming><bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Merge">
      <bpmn:incoming>Flow_07</bpmn:incoming><bpmn:incoming>Flow_08</bpmn:incoming><bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ShowResult" name="Показать результат по SKU и периоду">
      <bpmn:incoming>Flow_09</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_ReviewResult" name="Просмотреть результат">
      <bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_AnalysisReviewed" name="Анализ завершён">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="DataStore_EconomyRef" name="Продажи, расходы, версии плана" dataStoreRef="DataStore_Economy"/>
    <bpmn:association id="Association_ReadStoredData" sourceRef="DataStore_EconomyRef" targetRef="Task_LoadStoredData" associationDirection="One"/>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_AnalysisNeeded" targetRef="Task_SelectSkuPeriod"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_SelectSkuPeriod" targetRef="Task_LoadStoredData"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_LoadStoredData" targetRef="Gateway_HasSales"/>
    <bpmn:sequenceFlow id="Flow_04" name="Да" sourceRef="Gateway_HasSales" targetRef="Task_MatchPlanVersions"/>
    <bpmn:sequenceFlow id="Flow_05" name="Нет" sourceRef="Gateway_HasSales" targetRef="Task_NoSalesResult"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_MatchPlanVersions" targetRef="Task_CalculatePlanFact"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_CalculatePlanFact" targetRef="Gateway_Merge"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_NoSalesResult" targetRef="Gateway_Merge"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Gateway_Merge" targetRef="Task_ShowResult"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_ShowResult" targetRef="Task_ReviewResult"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_ReviewResult" targetRef="End_AnalysisReviewed"/>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_BP03" name="Анализ экономики SKU">
    <bpmn:participant id="Participant_Internal" name="Анализ экономики" processRef="BP03_PlanFact"/>
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram_BP03">
    <bpmndi:BPMNPlane id="Plane_BP03" bpmnElement="Collaboration_BP03">
      <bpmndi:BPMNShape id="Shape_Internal" bpmnElement="Participant_Internal" isHorizontal="true"><dc:Bounds x="40" y="70" width="2400" height="700"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ManagerLane" bpmnElement="Lane_Manager" isHorizontal="true"><dc:Bounds x="76" y="70" width="2364" height="220"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SystemLane" bpmnElement="Lane_MarginPilot" isHorizontal="true"><dc:Bounds x="76" y="290" width="2364" height="480"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start" bpmnElement="Start_AnalysisNeeded"><dc:Bounds x="178" y="163" width="44" height="44"/><bpmndi:BPMNLabel><dc:Bounds x="120" y="125" width="160" height="38"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Select" bpmnElement="Task_SelectSkuPeriod"><dc:Bounds x="320" y="139" width="210" height="92"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Load" bpmnElement="Task_LoadStoredData"><dc:Bounds x="600" y="374" width="210" height="92"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_HasSales" bpmnElement="Gateway_HasSales" isMarkerVisible="true"><dc:Bounds x="878" y="393" width="54" height="54"/><bpmndi:BPMNLabel><dc:Bounds x="850" y="459" width="110" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_MatchPlan" bpmnElement="Task_MatchPlanVersions"><dc:Bounds x="1040" y="374" width="210" height="92"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Calculate" bpmnElement="Task_CalculatePlanFact"><dc:Bounds x="1340" y="374" width="210" height="92"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_NoSales" bpmnElement="Task_NoSalesResult"><dc:Bounds x="1040" y="566" width="210" height="92"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Merge" bpmnElement="Gateway_Merge" isMarkerVisible="true"><dc:Bounds x="1623" y="393" width="54" height="54"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ShowResult" bpmnElement="Task_ShowResult"><dc:Bounds x="1760" y="374" width="210" height="92"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Review" bpmnElement="Task_ReviewResult"><dc:Bounds x="2050" y="139" width="210" height="92"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End" bpmnElement="End_AnalysisReviewed"><dc:Bounds x="2353" y="163" width="44" height="44"/><bpmndi:BPMNLabel><dc:Bounds x="2285" y="125" width="180" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Store" bpmnElement="DataStore_EconomyRef"><dc:Bounds x="600" y="606" width="210" height="99"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_01" bpmnElement="Flow_01"><di:waypoint x="222" y="185"/><di:waypoint x="320" y="185"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_02" bpmnElement="Flow_02"><di:waypoint x="425" y="231"/><di:waypoint x="425" y="420"/><di:waypoint x="600" y="420"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_03" bpmnElement="Flow_03"><di:waypoint x="810" y="420"/><di:waypoint x="878" y="420"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_04" bpmnElement="Flow_04"><di:waypoint x="932" y="420"/><di:waypoint x="1040" y="420"/><bpmndi:BPMNLabel><dc:Bounds x="928" y="390" width="38" height="22"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_05" bpmnElement="Flow_05"><di:waypoint x="905" y="447"/><di:waypoint x="905" y="612"/><di:waypoint x="1040" y="612"/><bpmndi:BPMNLabel><dc:Bounds x="886" y="500" width="45" height="22"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_06" bpmnElement="Flow_06"><di:waypoint x="1250" y="420"/><di:waypoint x="1340" y="420"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_07" bpmnElement="Flow_07"><di:waypoint x="1550" y="420"/><di:waypoint x="1623" y="420"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_08" bpmnElement="Flow_08"><di:waypoint x="1250" y="612"/><di:waypoint x="1650" y="612"/><di:waypoint x="1650" y="447"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_09" bpmnElement="Flow_09"><di:waypoint x="1677" y="420"/><di:waypoint x="1760" y="420"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_10" bpmnElement="Flow_10"><di:waypoint x="1865" y="374"/><di:waypoint x="1865" y="185"/><di:waypoint x="2050" y="185"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_11" bpmnElement="Flow_11"><di:waypoint x="2260" y="185"/><di:waypoint x="2353" y="185"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_ReadStore" bpmnElement="Association_ReadStoredData"><di:waypoint x="705" y="610"/><di:waypoint x="705" y="466"/><bpmndi:BPMNLabel><dc:Bounds x="716" y="530" width="80" height="22"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
